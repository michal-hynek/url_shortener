# add a new link alias
curl -X POST -H "content-type: application/json" <tailscale_ip>:8000/links --data '{ "alias": "foo", "url": "google.ca" }'

# get all links
curl -X GET <tailscale_ip>:8000/links

# get a single link
curl -X GET <tailscale_ip>:8000/links/<alias>

# update a link
curl -X PUT <tailscale_ip>:8000/links/<alias> -H "content-type: application/json" --data '{ "url": "google.ca" }'

# delete a link
curl -X DELETE <tailscale_ip>:8000/links/<alias>